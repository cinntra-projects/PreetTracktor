<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/graph_size_350"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_bg">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content">

            <!-- Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/muli_semibold"
                android:text="Follow Up"
                android:layout_weight="0.7"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/size_20" />

            <ImageView
                android:id="@+id/cross"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_cross"
                android:padding="@dimen/size_5"
                app:tint="@color/red"/>


        </LinearLayout>


        <!-- Radio Group for Follow Up and Reminder -->
        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFollowUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:paddingStart="10dp"
                android:checked="true"
                android:text="Follow Up"
                android:textColor="@color/black" />


            <RadioButton
                android:id="@+id/rbReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:paddingStart="10dp"
                android:text="Reminder"
                android:textColor="@color/black" />
        </RadioGroup>


    <LinearLayout
        android:id="@+id/reminder_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Date TextView -->
        <TextView
            android:id="@+id/txtDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10"
            android:visibility="visible"
            android:fontFamily="@font/muli_semibold"
            android:text="@string/date_mand"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16" />

        <!-- Date Section -->

            <EditText
                android:id="@+id/date_value"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_50"
                android:background="@drawable/rounded_border_edit"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_calendar_icon"
                android:fontFamily="@font/muli_regular"
                android:hint="@string/date"
                android:layout_marginTop="@dimen/size_10"
                android:paddingStart="@dimen/size_10"
                android:paddingEnd="@dimen/size_10"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16" />



        <!-- Time TextView -->
        <TextView
            android:id="@+id/txtTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:visibility="visible"
            android:fontFamily="@font/muli_semibold"
            android:text="@string/time_mand"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16" />



            <EditText
                android:id="@+id/time_value"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_50"
                android:background="@drawable/rounded_border_edit"
                android:focusable="false"
                android:drawableEnd="@drawable/baseline_access_time_24"
                android:layout_marginTop="@dimen/size_10"
                android:fontFamily="@font/muli_regular"
                android:hint="HH:MM"
                android:paddingStart="@dimen/size_10"
                android:paddingEnd="@dimen/size_10"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_16" />




    </LinearLayout>
        <TextView
            android:id="@+id/communication_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:layout_marginBottom="@dimen/size_10"
            android:text="@string/select_mode_of_communication"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutCommunication"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select Mode Of Communication"
            android:layout_marginTop="@dimen/size_2"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp">

            <AutoCompleteTextView
                android:id="@+id/communication_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:dropDownHeight="200dp"
                android:entries="@array/communications"
                android:maxLines="1"
                android:textSize="12sp" />
        </com.google.android.material.textfield.TextInputLayout>


        <!-- Comment Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20"
            android:fontFamily="@font/muli_semibold"
            android:text="@string/comment_mand"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_16" />

        <EditText
            android:id="@+id/comment_value"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_100"
            android:layout_marginTop="@dimen/size_10"
            android:background="@drawable/rounded_border_edit"
            android:fontFamily="@font/muli_regular"
            android:gravity="start"
            android:hint="Enter comment"
            android:padding="@dimen/size_10"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_14" />

        <!-- Add Button -->
        <Button
            android:id="@+id/add"
            android:layout_width="@dimen/size_120"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/size_20"
            android:background="@drawable/button_rounded_corner"
            android:fontFamily="@font/muli_semibold"
            android:gravity="center"
            android:text="Add"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_16" />

    </LinearLayout>


</ScrollView>