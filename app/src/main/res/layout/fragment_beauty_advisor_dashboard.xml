<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F9F9FF"
    tools:context=".ui.fragment.BeautyAdvisorDashboardFragment">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.cardview.widget.CardView
        android:id="@+id/cvTargetGraph"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/size_4"
        android:layout_marginHorizontal="@dimen/size_10"
        app:cardUseCompatPadding="true"
        android:layout_weight="0.5"
        app:cardCornerRadius="@dimen/size_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/layoutTargetGraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/size_10"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tvTotalTargetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/size_8"
                android:includeFontPadding="false"
                android:text="Target Assigned Vs Target Achieved"
                android:textSize="@dimen/text_size_14"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/color_0B0B10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/mpChartTargetAchieved"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_210"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutTargetGraph"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/size_8"
                    android:includeFontPadding="false"
                    android:text="Target Assigned"
                    android:textSize="@dimen/text_size_16"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvAchieved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/size_8"
                    android:layout_marginStart="@dimen/size_20"
                    android:includeFontPadding="false"
                    android:text="Target Achieved"
                    android:textSize="@dimen/text_size_16"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvSalesGraph"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="@dimen/size_4"
        android:layout_marginHorizontal="@dimen/size_10"
        app:cardUseCompatPadding="true"
        android:layout_weight="0.5"
        app:cardCornerRadius="@dimen/size_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvTargetGraph">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/size_10">
            <TextView
                android:id="@+id/tvTotalSalesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/size_8"
                android:includeFontPadding="false"
                android:text="Total Sales"
                android:textSize="@dimen/text_size_14"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/color_0B0B10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/mpChartSales"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_210"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTotalSalesLabel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cvSalesGraph">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="@dimen/size_150"
            app:cardElevation="@dimen/size_4"
            app:cardUseCompatPadding="true"
            android:layout_weight="0.5"
            app:cardCornerRadius="@dimen/size_15">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/size_20">
                <TextView
                    android:id="@+id/tvIncentiveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_incentive"
                    android:drawablePadding="@dimen/size_8"
                    android:includeFontPadding="false"
                    android:text="Incentive"
                    android:textSize="@dimen/text_size_16"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/color_0B0B10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvMonthFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15"
                    android:paddingVertical="@dimen/size_4"
                    android:paddingHorizontal="@dimen/size_10"
                    android:visibility="gone"
                    android:background="@drawable/bg_light_blue"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:text="This Month"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvIncentiveLabel"/>

                <TextView
                    android:id="@+id/tvIncentiveAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15"
                    android:fontFamily="@font/poppins_bold"
                    android:drawableStart="@drawable/ic_rupee_symbol"
                    android:drawablePadding="@dimen/size_2"
                    android:paddingHorizontal="@dimen/size_10"
                    android:paddingVertical="@dimen/size_4"
                    android:text="34,455"
                    android:textColor="@color/color_0B0B10"
                    android:textSize="@dimen/text_size_18"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMonthFilter" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvLogs"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_150"
            app:cardElevation="@dimen/size_4"
            app:cardUseCompatPadding="true"
            android:layout_weight="0.5"
            app:cardCornerRadius="@dimen/size_15">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="@dimen/size_10"
                android:paddingHorizontal="@dimen/size_10">
                <TextView
                    android:id="@+id/tvIncentiveLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_logs"
                    android:drawablePadding="@dimen/size_8"
                    android:includeFontPadding="false"
                    android:text="Logs"
                    android:textSize="@dimen/text_size_16"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/color_0B0B10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tvLabelBelow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_10"
                    android:paddingVertical="@dimen/size_2"
                    android:paddingHorizontal="@dimen/size_2"
                    android:textSize="@dimen/size_10"
                    android:text="Track all sales activities"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvIncentiveLogs"/>

                <ImageButton
                    android:id="@+id/tvBtnLogs"
                    android:layout_width="70dp"
                    android:clickable="false"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/size_4"
                    android:fontFamily="@font/poppins_bold"
                    android:src="@drawable/ic_arrow_left_24dp"
                    android:background="@drawable/bg_button_blue_rounded"
                    android:textSize="@dimen/text_size_18"
                    android:textColor="@color/color_0B0B10"
                    android:text=""
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelBelow"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>