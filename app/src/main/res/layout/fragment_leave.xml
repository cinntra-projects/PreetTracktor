<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="5dp"
    tools:context=".ui.fragment.LeaveFragment">

    <LinearLayout
        android:id="@+id/linearDateFilter"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tvFromDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:text="@string/start_date"
            android:textColor="@color/black_text_color"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvDate"
            app:layout_constraintEnd_toStartOf="@+id/tvDate"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvDate"
            />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"

            android:drawableStart="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="#00117C"
            android:gravity="center_vertical"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="visible"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/lvlToDate"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tvFromDate"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lvlToDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:clickable="true"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:text="@string/to_date"
            android:textColor="@color/black_text_color"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvDate"
            app:layout_constraintEnd_toStartOf="@+id/tvToDate"

            app:layout_constraintStart_toEndOf="@+id/tvDate"
            app:layout_constraintTop_toTopOf="@+id/tvDate"
            />

        <TextView
            android:id="@+id/tvToDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:drawableStart="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="#00117C"
            android:gravity="center_vertical"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:visibility="visible"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@+id/lvlToDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/lvlToDate"
            app:layout_constraintTop_toTopOf="@id/lvlToDate" />

    </LinearLayout>





    <TextView

        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="3dp"
        android:drawableStart="@drawable/ic_calendar_icon"
        android:drawablePadding="3dp"
        android:gravity="center"
        android:text=""
        android:visibility="gone"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvAdd"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="15dp"
        android:background="@drawable/rounded_corner_bg_add"
        android:clickable="true"
        android:drawableStart="@drawable/plus_icon"
        android:drawablePadding="3dp"
        android:drawableTint="@color/white"
        android:gravity="center"
        android:padding="3dp"
        android:text="Add"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearDateFilter" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLeave"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAdd">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp">

            <TextView
                android:id="@+id/tvFromdate"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="From"
                android:textColor="@color/black_text_color"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTodate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="To"
                android:textColor="@color/black_text_color"
                android:textSize="14dp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/tvFromdate"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvType"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="Type"
                android:textColor="@color/black_text_color"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etFromDateSelected"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/admin_border"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar_icon"
                android:drawablePadding="@dimen/dimen_8"
                android:focusable="false"
                android:text="28/08/2024"
                android:textColor="@color/black_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvFromdate"
                app:layout_constraintWidth_percent=".45" />

            <TextView
                android:id="@+id/etFromDateSelected1"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/admin_border"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar_icon"
                android:drawablePadding="@dimen/dimen_8"
                android:text="28 Aug"
                android:textColor="@color/black_text_color"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvFromdate" />

            <EditText
                android:id="@+id/etToDateSelected"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/admin_border"
                android:clickable="true"
                android:drawableEnd="@drawable/ic_calendar_icon"
                android:drawablePadding="@dimen/dimen_8"
                android:focusable="false"
                android:text="28 Aug"
                android:textColor="@color/black_text_color"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/tvTodate"
                app:layout_constraintStart_toStartOf="@+id/tvTodate"
                app:layout_constraintTop_toBottomOf="@+id/tvTodate" />

            <Spinner
                android:id="@+id/spinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/spinner_border"
                android:popupBackground="@drawable/spinner_border"
                android:spinnerMode="dropdown"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/tvType"
                app:layout_constraintStart_toStartOf="@+id/tvType"
                app:layout_constraintTop_toBottomOf="@+id/tvType" />

            <TextView
                android:id="@+id/etTypeSelected"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/spinner_border"
                android:clickable="true"
                android:drawableRight="@drawable/arrow_drop_down_line_icon"
                android:text="Select.."
                android:textColor="@color/black_text_color"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@+id/tvType"
                app:layout_constraintStart_toStartOf="@+id/tvType"
                app:layout_constraintTop_toBottomOf="@+id/tvType" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etReason"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/admin_border"
                android:gravity="top|left"
                android:hint="Reason"
                android:maxLength="80"
                android:textColor="@color/black_text_color"
                android:textColorHint="@android:color/darker_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/etFromDateSelected"
                app:layout_constraintTop_toBottomOf="@+id/etFromDateSelected" />

            <View
                android:id="@+id/view"
                android:layout_width="1dp"
                android:layout_height="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etReason" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="3dp"
                android:background="@drawable/rounded_corner_bg_add"
                android:clickable="true"
                android:gravity="center|center_vertical"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@id/view"
                app:layout_constraintTop_toBottomOf="@+id/etReason" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginLeft="3dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/cancel_4dp"
                android:clickable="true"
                android:gravity="center|center_vertical"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/purple_700"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/view"
                app:layout_constraintTop_toBottomOf="@+id/etReason" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/gray_60"
        app:layout_constraintTop_toBottomOf="@+id/cardLeave" />

    <RadioGroup
        android:id="@+id/rgLeave"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintTop_toBottomOf="@+id/view1">

        <RadioButton
            android:id="@+id/allRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="true"
            android:gravity="center"
            android:text="All"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/pendingRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="false"
            android:gravity="center"
            android:text="Pending"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/approvedRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="false"
            android:gravity="center"
            android:text="Approved"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rejecedRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="false"
            android:gravity="center"
            android:text="Rejected"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />
    </RadioGroup>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_60"
        app:layout_constraintBottom_toBottomOf="@+id/rgLeave" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeave"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:indeterminateTint="@color/purple_700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/noDataFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view2">

        <include android:id="@+id/noDataFoundLayout"
            layout="@layout/no_data_found_layout"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>