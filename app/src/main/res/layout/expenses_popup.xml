<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/admin_border"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvConveyance"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:drawableLeft="@drawable/right_arrow_icon"
        android:gravity="center_vertical"
        android:text="Conveyance"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutConveyance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ex_concey_bg"
        android:padding="8dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/tvConveyance"
        app:layout_constraintStart_toStartOf="@id/tvConveyance"
        app:layout_constraintTop_toBottomOf="@+id/tvConveyance">

        <EditText
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:alpha=".7"
            android:background="@drawable/rounded_corner_4dp"
            android:drawableEnd="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center"
            android:text="01 Aug"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".21" />

        <TextView
            android:id="@+id/tvDate1"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:alpha=".7"
            android:background="@drawable/rounded_corner_4dp"
            android:drawableEnd="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center"
            android:text="01 Aug"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".21" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="@dimen/dimen_8"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="Location"
            android:maxLines="1"
            android:paddingLeft="@dimen/dimen_4"
            android:textColor="@color/black_text_color"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tvDate"
            app:layout_constraintTop_toTopOf="@id/tvDate"
            app:layout_constraintWidth_percent=".37" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinnerMode"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_corner_4dp"
            android:entries="@array/mode_spinner"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/tvDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etLocation"
            app:layout_constraintTop_toTopOf="@id/tvDate"
            app:layout_constraintWidth_percent=".35" />

        <EditText
            android:id="@+id/etRemark"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="Remark"
            android:maxLines="1"
            android:paddingLeft="@dimen/dimen_4"
            android:textColor="@color/black_text_color"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/tvDate"
            app:layout_constraintTop_toBottomOf="@id/tvDate"
            app:layout_constraintWidth_percent=".33" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAmount"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_corner_4dp"
            app:layout_constraintBottom_toBottomOf="@id/etRemark"
            app:layout_constraintStart_toEndOf="@+id/etRemark"
            app:layout_constraintTop_toTopOf="@id/etRemark"
            app:layout_constraintWidth_percent=".33">

            <TextView
                android:id="@+id/tvRupee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:gravity="center"
                android:text="\u20B9"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent=".13" />

            <View
                android:id="@+id/view"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintStart_toEndOf="@id/tvRupee"></View>

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:background="#0000"
                android:gravity="right|center_vertical"
                android:hint="Amount"
                android:inputType="number"
                android:maxLines="1"
                android:paddingLeft="@dimen/dimen_4"
                android:paddingRight="8dp"
                android:textColor="@color/black_text_color"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/view"
                app:layout_constraintTop_toTopOf="@id/view" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/tvCamera"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ex_camera_border"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_camera"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/layoutAmount"
            app:layout_constraintStart_toEndOf="@id/layoutAmount"
            app:layout_constraintTop_toTopOf="@id/layoutAmount"
            app:layout_constraintWidth_percent=".11"
            app:tint="#039E3A" />

        <TextView
            android:id="@+id/tvAdd"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:background="@drawable/save_4dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/tvCamera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvCamera"
            app:layout_constraintTop_toTopOf="@id/tvCamera"
            app:layout_constraintWidth_percent=".15" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="#DCDCDC"
        app:layout_constraintTop_toBottomOf="@+id/layoutConveyance" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLodging"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:drawableLeft="@drawable/right_arrow_icon"
        android:gravity="center_vertical"
        android:text="Lodging"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutLodging"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/ex_concey_bg"
        android:padding="8dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/tvLodging"
        app:layout_constraintStart_toStartOf="@id/tvLodging"
        app:layout_constraintTop_toBottomOf="@+id/tvLodging">

        <TextView
            android:id="@+id/lvlFromDate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:alpha="1"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:text="From"
            android:textColor="@color/black_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".2" />

        <TextView
            android:id="@+id/lvlToDate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="@dimen/dimen_4"
            android:alpha="1"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:text="To"
            android:textColor="@color/black_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/lvlFromDate"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".2" />

        <TextView
            android:id="@+id/tvFromDate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:alpha=".7"
            android:background="@drawable/rounded_corner_4dp"
            android:drawableEnd="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center"
            android:text="01 Aug"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lvlFromDate"
            app:layout_constraintWidth_percent=".2" />

        <TextView
            android:id="@+id/tvToDate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginLeft="@dimen/dimen_4"
            android:alpha=".7"
            android:background="@drawable/rounded_corner_4dp"
            android:drawableEnd="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center"
            android:text="01 Aug"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tvFromDate"
            app:layout_constraintTop_toTopOf="@id/tvFromDate"
            app:layout_constraintWidth_percent=".21" />

        <EditText
            android:id="@+id/etLodgeLocation"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="@dimen/dimen_8"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="Location"
            android:maxLines="1"

            android:paddingLeft="@dimen/dimen_4"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/tvToDate"
            app:layout_constraintTop_toTopOf="@id/tvToDate"
            app:layout_constraintWidth_percent=".24" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etNoOfPeople"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="No. of People"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/tvFromDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etLodgeLocation"
            app:layout_constraintTop_toTopOf="@id/tvFromDate"
            app:layout_constraintWidth_percent=".28" />

        <EditText
            android:id="@+id/etHotelName"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="Hotel Name"
            android:maxLines="1"
            android:paddingLeft="@dimen/dimen_4"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/tvFromDate"
            app:layout_constraintTop_toBottomOf="@id/tvFromDate"
            app:layout_constraintWidth_percent=".33" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutLodgeAmount"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_corner_4dp"
            app:layout_constraintBottom_toBottomOf="@id/etHotelName"
            app:layout_constraintStart_toEndOf="@+id/etHotelName"
            app:layout_constraintTop_toTopOf="@id/etHotelName"
            app:layout_constraintWidth_percent=".33">

            <TextView
                android:id="@+id/tvLodgeRupee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:gravity="center"
                android:text="\u20B9"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent=".13" />

            <View
                android:id="@+id/viewLodge"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintStart_toEndOf="@id/tvLodgeRupee"></View>

            <EditText
                android:id="@+id/etLodgeAmount"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:background="#0000"
                android:gravity="right|center_vertical"
                android:hint="Amount"
                android:maxLines="1"
                android:paddingLeft="@dimen/dimen_4"
                android:paddingRight="8dp"
                android:textColor="@color/black_text_color"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/viewLodge"
                app:layout_constraintTop_toTopOf="@id/viewLodge" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/tvLodgeCamera"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ex_camera_border"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_camera"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/layoutLodgeAmount"
            app:layout_constraintStart_toEndOf="@id/layoutLodgeAmount"
            app:layout_constraintTop_toTopOf="@id/layoutLodgeAmount"
            app:layout_constraintWidth_percent=".11"
            app:tint="#039E3A" />

        <TextView
            android:id="@+id/tvLodgeAdd"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:background="@drawable/save_4dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/tvLodgeCamera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvLodgeCamera"
            app:layout_constraintTop_toTopOf="@id/tvLodgeCamera"
            app:layout_constraintWidth_percent=".15" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="#DCDCDC"
        app:layout_constraintTop_toBottomOf="@+id/layoutLodging" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFood"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:drawableLeft="@drawable/right_arrow_icon"
        android:gravity="center_vertical"
        android:text="Food"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutFood"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_4"
        android:layout_marginRight="@dimen/dimen_4"
        android:background="@drawable/ex_concey_bg"
        android:padding="8dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/tvFood"
        app:layout_constraintStart_toStartOf="@id/tvFood"
        app:layout_constraintTop_toBottomOf="@+id/tvFood">

        <TextView
            android:id="@+id/tvFoodDate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:alpha=".7"
            android:background="@drawable/rounded_corner_4dp"
            android:drawableEnd="@drawable/ic_calendar_icon"
            android:drawablePadding="3dp"
            android:drawableTint="@color/black_text_color"
            android:gravity="center"
            android:text="01 Aug"
            android:textColor="@color/black_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".21" />

        <EditText
            android:id="@+id/etFoodLocation"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="@dimen/dimen_8"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="Location"
            android:maxLines="1"
            android:paddingLeft="@dimen/dimen_4"
            android:textColor="@color/black_text_color"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/tvFoodDate"
            app:layout_constraintTop_toTopOf="@id/tvFoodDate"
            app:layout_constraintWidth_percent=".37" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/rounded_corner_4dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/tvFoodDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/etFoodLocation"
            app:layout_constraintTop_toTopOf="@id/tvFoodDate"
            app:layout_constraintWidth_percent=".35" />

        <EditText
            android:id="@+id/etMeal"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_corner_4dp"
            android:hint="Meal"
            android:maxLines="1"
            android:paddingLeft="@dimen/dimen_4"
            android:textColor="@color/black_text_color"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/tvFoodDate"
            app:layout_constraintTop_toBottomOf="@id/tvFoodDate"
            app:layout_constraintWidth_percent=".33" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutFoodAmount"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_corner_4dp"
            app:layout_constraintBottom_toBottomOf="@id/etMeal"
            app:layout_constraintStart_toEndOf="@+id/etMeal"
            app:layout_constraintTop_toTopOf="@id/etMeal"
            app:layout_constraintWidth_percent=".33">

            <TextView
                android:id="@+id/tvFoodRupee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:gravity="center"
                android:text="\u20B9"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent=".13" />

            <View
                android:id="@+id/viewFood"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintStart_toEndOf="@id/tvFoodRupee"></View>

            <EditText
                android:id="@+id/etFoodAmount"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:background="#0000"
                android:gravity="right|center_vertical"
                android:hint="Amount"
                android:maxLines="1"
                android:paddingLeft="@dimen/dimen_4"
                android:paddingRight="8dp"
                android:textColor="@color/black_text_color"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/viewFood"
                app:layout_constraintTop_toTopOf="@id/viewFood"
                tools:ignore="MissingConstraints" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/tvFoodCamera"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ex_camera_border"
            android:padding="3dp"
            android:src="@android:drawable/ic_menu_camera"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/layoutFoodAmount"
            app:layout_constraintStart_toEndOf="@id/layoutFoodAmount"
            app:layout_constraintTop_toTopOf="@id/layoutFoodAmount"
            app:layout_constraintWidth_percent=".11"
            app:tint="#039E3A" />

        <TextView
            android:id="@+id/tvFoodAdd"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:background="@drawable/save_4dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/tvFoodCamera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvFoodCamera"
            app:layout_constraintTop_toTopOf="@id/tvFoodCamera"
            app:layout_constraintWidth_percent=".15" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="-4dp"
        android:layout_marginTop="20dp"
        android:background="#DCDCDC"
        app:layout_constraintTop_toBottomOf="@+id/layoutFood" />

    <View
        android:id="@+id/view4"
        android:layout_width="1dp"
        android:layout_height="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3" />

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="90dp"
        android:layout_height="35dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/rounded_corner_bg_add"
        android:clickable="true"
        android:gravity="center|center_vertical"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@id/view4"
        app:layout_constraintTop_toBottomOf="@+id/view3" />

    <TextView
        android:id="@+id/btnCancel"
        android:layout_width="90dp"
        android:layout_height="35dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/cancel_4dp"
        android:clickable="true"
        android:gravity="center|center_vertical"
        android:text="Cancel"
