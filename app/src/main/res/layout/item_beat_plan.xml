<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:layout_marginBottom="16dp"
    android:elevation="4dp"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!-- LinearLayout to hold Timing and Priority Spinners -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business_partner"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    android:textColor="@color/light_text_color"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/ibCross"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"

                    android:background="@android:color/transparent"
                    android:src="@drawable/close_circle_icon" />

            </LinearLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Business Partner"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <!-- AutoCompleteTextView for customer search -->
                <AutoCompleteTextView
                    android:id="@+id/autoCompleteCustomer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Business Partner"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:popupBackground="@drawable/dropdown_bg"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>


        <!-- LinearLayout to hold Timing and Priority Spinners -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_70"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timing"
                    android:textColor="@color/light_text_color"
                    android:textSize="14sp" />

                <!-- Timing Spinner -->
                <Spinner
                    android:id="@+id/spinnerTiming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Timing"
                    android:padding="10dp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/edtTiming"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_edittext"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Timing"
                    android:inputType="none"
                    android:padding="10dp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/priority"
                    android:textColor="@color/light_text_color"
                    android:textSize="14sp" />

                <!-- Priority Spinner -->
                <Spinner
                    android:id="@+id/spinnerPriority"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_edittext"
                    android:hint="Priority"
                    android:padding="10dp" />


            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_of_travel"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    android:textColor="@color/light_text_color"
                    android:textSize="14sp" />


            </LinearLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <!-- AutoCompleteTextView for customer search -->
                <AutoCompleteTextView
                    android:id="@+id/acModeOfTravel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/mode_of_travel"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:popupBackground="@drawable/dropdown_bg"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remark"
                android:textColor="@color/light_text_color"
                android:textSize="14sp" />

            <!-- EditText for remarks -->
            <EditText
                android:id="@+id/editTextRemark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_edittext"
                android:hint="Remark"
                android:padding="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"
            android:orientation="horizontal">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_60"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/size_4"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#D1F2D0D0">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/billing"
                        android:fontFamily="@font/muli_bold"
                        android:textColor="@color/red"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/billing_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:fontFamily="@font/muli_regular"
                        android:textColor="@color/black_text"
                        android:textSize="@dimen/text_size_14" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_60"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/size_4"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#B6D3D7F0">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/delivery"
                        android:fontFamily="@font/muli_bold"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/delivery_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:fontFamily="@font/muli_regular"
                        android:textColor="@color/black_text"
                        android:textSize="@dimen/text_size_14" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_10"
            android:orientation="horizontal">


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_60"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/size_4"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#EAFAEECB">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/retail"
                        android:fontFamily="@font/muli_bold"
                        android:textColor="@color/orange_color"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/retail_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:fontFamily="@font/muli_regular"
                        android:textColor="@color/black_text"
                        android:textSize="@dimen/text_size_14" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_60"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/size_4"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="#D5F6D6">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/collection"
                        android:fontFamily="@font/muli_bold"
                        android:textColor="@color/green_approved"
                        android:textSize="@dimen/text_size_16" />

                    <TextView
                        android:id="@+id/collection_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:layout_gravity="center"
                        android:fontFamily="@font/muli_regular"
                        android:textColor="@color/black_text"
                        android:textSize="@dimen/text_size_14" />


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>


    </LinearLayout>


</androidx.cardview.widget.CardView>