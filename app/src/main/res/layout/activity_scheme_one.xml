<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.SchemeOneActivity">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardToolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="6dp"
        android:background="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:paddingBottom="8dp"
            android:paddingEnd="@dimen/dimen_8"
            android:paddingStart="@dimen/size_4"
            android:paddingTop="8dp">


            <!-- Add Drawer Button -->
            <ImageView
                android:id="@+id/btnDrawer"
                android:layout_width="32dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_hamburger_menu"
                android:backgroundTint="@color/colorPrimary"
                app:tint="@color/white"
                android:visibility="gone"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <!-- Logo Icon -->
            <ImageView
                android:id="@+id/ivLogoIcon"
                android:layout_width="60dp"
                android:layout_height="24dp"
                android:src="@mipmap/ic_launcher_foreground"
                android:visibility="visible"
                android:layout_marginTop="3dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/btnDrawer"
                />

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="visible"


                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivCollapseCart"
                app:layout_constraintStart_toStartOf="@+id/ivLogoIcon"
                app:layout_constraintTop_toBottomOf="@+id/ivLogoIcon" />

            <!-- Notification Button -->
            <ImageButton
                android:id="@+id/ibNotify"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="@color/colorPrimary"
                android:src="@drawable/ic_notification"
                app:layout_constraintEnd_toStartOf="@+id/profile_icon"
                app:layout_constraintTop_toTopOf="@id/profile_icon"
                app:layout_constraintBottom_toBottomOf="@id/profile_icon"
                app:tint="@color/white" />

            <!-- Cart Button -->
            <ImageView
                android:id="@+id/ivCollapseCart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:backgroundTint="@color/colorPrimary"
                android:src="@drawable/ic_shop"
                app:tint="@color/white"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toStartOf="@+id/ibNotify"
                app:layout_constraintTop_toTopOf="@id/profile_icon"
                app:layout_constraintBottom_toBottomOf="@id/profile_icon" />

            <!-- Cart Counter -->
            <TextView
                android:id="@+id/tvCartCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/background_round_corners_red"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="8sp"
                app:layout_constraintEnd_toEndOf="@id/ivCollapseCart"
                app:layout_constraintStart_toStartOf="@id/ivCollapseCart"
                app:layout_constraintTop_toTopOf="@id/ivCollapseCart" />

            <!-- Profile Icon -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_icon"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_centerInParent="true"
                android:layout_marginStart="5dp"
                android:background="@drawable/imageview_background"
                android:src="@drawable/deafult_image"
                app:civ_border_color="@color/colorPrimary"
                app:civ_border_width="2dp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLayout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardToolBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/ivBackPress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:src="@drawable/back_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />


            <TextView
                android:id="@+id/tvTitleOfDoc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Feedback"
                android:textColor="@color/black_text_color"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivBackPress"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:src="@drawable/image_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardLayout" />

    <!--    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardToolBar"
            app:layout_constraintBottom_toTopOf="@+id/btnShare">

          &lt;!&ndash;  <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


            </androidx.constraintlayout.widget.ConstraintLayout>
    &ndash;&gt;



        </ScrollView>-->

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/dimen_8"
        android:layout_weight="45"
        android:fontFamily="@font/poppins_semibold"
        android:text="Your Opinions Matters to Us"
        android:textColor="@color/black_text"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent" />
    <!--
        app:layout_constraintTop_toBottomOf="@id/ivImage"-->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_16"
        android:text="Share"
        android:textAllCaps="false"
        android:textSize="@dimen/text_size_16"
        app:cornerRadius="@dimen/dimen_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>