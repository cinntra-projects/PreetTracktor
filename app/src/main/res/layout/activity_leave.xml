<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.LeaveActivity">

    <TextView

        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="3dp"
        android:drawableStart="@drawable/ic_calendar_icon"
        android:drawablePadding="3dp"
        android:gravity="center"
        android:text=""
        android:visibility="gone"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFromDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:text="@string/start_date"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDate"
        app:layout_constraintEnd_toStartOf="@+id/tvDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDate"
        />

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:drawableStart="@drawable/ic_calendar_icon"
        android:drawablePadding="3dp"
        android:drawableTint="#00117C"
        android:gravity="center_vertical"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:visibility="visible"
        android:textSize="10sp"
        app:layout_constraintEnd_toStartOf="@+id/lvlToDate"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tvFromDate"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lvlToDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:clickable="true"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:text="@string/to_date"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tvDate"
        app:layout_constraintEnd_toStartOf="@+id/tvToDate"

        app:layout_constraintStart_toEndOf="@+id/tvDate"
        app:layout_constraintTop_toTopOf="@+id/tvDate"
        />

    <TextView
        android:id="@+id/tvToDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:drawableStart="@drawable/ic_calendar_icon"
        android:drawablePadding="3dp"
        android:drawableTint="#00117C"
        android:gravity="center_vertical"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:visibility="visible"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@+id/lvlToDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/lvlToDate"
        app:layout_constraintTop_toTopOf="@id/lvlToDate" />


    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="@color/gray_60"
        app:layout_constraintTop_toBottomOf="@id/tvDate" />

    <RadioGroup
        android:id="@+id/rgLeave"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintTop_toBottomOf="@+id/view1">

        <RadioButton
            android:id="@+id/allRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="true"
            android:gravity="center"
            android:text="All"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/pendingRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="false"
            android:gravity="center"
            android:text="Pending"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/approvedRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="false"
            android:gravity="center"
            android:text="Approved"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rejecedRB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/leave_bg_selector"
            android:button="@android:color/transparent"
            android:checked="false"
            android:gravity="center"
            android:text="Rejected"
            android:textColor="@color/leavetext_seletor"
            android:textStyle="bold" />
    </RadioGroup>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_60"
        app:layout_constraintBottom_toBottomOf="@+id/rgLeave" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeave"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2" />

    <include
        android:id="@+id/noDataFoundLayout"
        layout="@layout/no_data_found_layout" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/purple_700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>