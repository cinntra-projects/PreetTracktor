<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    app:cardCornerRadius="@dimen/size_10"
    app:cardElevation="@dimen/size_4"
    app:cardUseCompatPadding="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/linearTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_10"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/poppins_regular"
                android:singleLine="true"
                android:text="1- Item 1"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_14"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivShowHideArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivShowHideArrow"
                android:layout_width="@dimen/size_30"
                android:layout_height="@dimen/size_30"
                android:layout_marginEnd="@dimen/size_8"
                android:paddingHorizontal="@dimen/size_5"
                android:src="@drawable/ic_collapse"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvItemPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/poppins_regular"
                android:text="Unit Price: 1200"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvItemQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/poppins_regular"
                android:singleLine="true"
                android:text="Quantity: 1"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:id="@+id/layoutShowHide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/size_0"
                android:paddingBottom="@dimen/size_4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="start"
                    android:text="Base Amount"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTotalBillingAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/size_0"
                android:paddingBottom="@dimen/size_4">

                <TextView
                    android:id="@+id/tvItemDiscLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="start"
                    android:text="Item Discount"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvItemDiscAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/size_0"
                android:paddingBottom="@dimen/size_4"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvHeaderDiscLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="start"
                    android:text="Header Discount"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHeaderDescAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/size_0"
                android:paddingBottom="@dimen/size_4">

                <TextView
                    android:id="@+id/tvTaxRateLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="start"
                    android:text="Tax Rate"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTaxRateAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/size_0"
                android:paddingBottom="@dimen/size_4">

                <TextView
                    android:id="@+id/tvFreightChargeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="start"
                    android:text="Freight Charges"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFreightChargeAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_weight="50"
                    android:gravity="end"
                    android:text="0.00"
                    android:textColor="@color/black_text"
                    android:textSize="11sp" />


            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1"
                android:background="@color/devider_color_reports" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/size_0"
            android:paddingTop="@dimen/size_6">

            <TextView

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:layout_weight="50"
                android:gravity="start"
                android:text="Grand Total"
                android:textColor="@color/black_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotalInvoiceAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:layout_weight="50"
                android:gravity="end"
                android:text="0.00"
                android:textColor="@color/black_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>