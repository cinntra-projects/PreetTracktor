<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    android:background="@drawable/admin_border">


    <ImageView
        android:id="@+id/delete"
        android:layout_width="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content"
        android:background="@drawable/baseline_cancel_24"
        android:visibility="gone"
        android:backgroundTint="@color/grey" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp"
        app:layout_constraintTop_toBottomOf="@id/delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <AutoCompleteTextView
            android:id="@+id/customer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_border"
            android:drawableEnd="@drawable/ccp_ic_arrow_drop_down"
            android:hint="Customer"
            android:textSize="14sp"
            android:padding="5dp"/>

        <AutoCompleteTextView
            android:id="@+id/employee_list"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/admin_border"
            android:drawableEnd="@drawable/ccp_ic_arrow_drop_down"
            android:hint="Assigned to"
            android:textSize="14sp"
            android:padding="5dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="5dp"
        android:background="@drawable/admin_border"
        android:layout_height="wrap_content">

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/timing_array"
            />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/admin_border"
            android:layout_height="wrap_content">
        <Spinner
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/priority_array"
           />
        </LinearLayout>

    </LinearLayout>

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dimen_48"
            android:hint="Remarks"
            android:maxLength="400"
            android:maxLines="4"
            android:textSize="14sp"
            android:padding="5dp"
            android:background="@drawable/admin_border"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>