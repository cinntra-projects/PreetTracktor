            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:padding="@dimen/dimen_8"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@id/ibArrowButton"
            app:layout_constraintTop_toTopOf="@id/ibArrowButton">

            <TextView
                android:id="@+id/tvTypeOfExpense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="20"
                android:gravity="start"
                android:text="Conveyance"
                android:textColor="@color/black_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tvDateExpand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:layout_weight="40"
                android:gravity="start"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="01 Feb 2024"
                android:textColor="#414141"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTypeOfExpense" />

            <ImageView
                android:id="@+id/ivLocation"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:padding="2dp"
                android:src="@drawable/ic_pin_expense"
                app:layout_constraintStart_toEndOf="@+id/tvDateExpand"
                app:layout_constraintTop_toTopOf="@+id/tvDateExpand" />

            <TextView
