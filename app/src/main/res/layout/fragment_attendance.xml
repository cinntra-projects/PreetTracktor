    <androidx.constraintlayout.widget.Group
        android:id="@+id/dateGroup"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:constraint_referenced_ids="tvFromDate"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFromDate"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:clickable="true"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:text="@string/start_date"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent=".2" />

    <EditText
        android:id="@+id/inputFromDate"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@color/white"
        android:clickable="true"
        android:drawableStart="@drawable/ic_calendar_icon"
        android:drawablePadding="5dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:text=""
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/black_text_color"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/tvFromDate"
        app:layout_constraintWidth_percent=".3"
        tools:text="01/08/2024" />

    <TextView
        android:id="@+id/tvToDate"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/to_date"
        android:textColor="@color/black_text_color"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/inputFromDate"
        app:layout_constraintWidth_percent=".2" />

    <EditText
        android:id="@+id/inputToDate"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/white"
        android:clickable="true"
        android:drawableStart="@drawable/ic_calendar_icon"
        android:drawablePadding="5dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:text=""
        android:textColor="@color/black_text_color"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/tvToDate"
        app:layout_constraintWidth_percent=".3"
        tools:text="27/08/2024" />


    <LinearLayout
        android:id="@+id/linearTrackingDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/gray_60"
        android:orientation="horizontal"
        android:padding="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFromDate">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="20"
            android:gravity="center"
            android:text="Date"
            android:textColor="#414141"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="30"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="50"
                android:text="Check-In"
                android:textColor="#414141"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivChekcInImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_image" />

                <ImageView
                    android:id="@+id/ivcheckInImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_pin" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="30"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTimeCheckOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Check-Out"
                android:textColor="#414141"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivCheckInImage"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"

                    android:src="@drawable/ic_image" />

                <ImageView
                    android:id="@+id/ivCheckOutPin"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_pin" />

            </LinearLayout>


        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalHrs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="20"
            android:gravity="center"
            android:text="Total Hrs"
            android:textColor="#414141"
            android:textSize="14sp"
            android:textStyle="bold" />


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOuterList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearTrackingDetails"
        tools:listitem="@layout/item_user_tracking_listing" />

    <include
        android:id="@+id/noDataFoundLayout"
        layout="@layout/no_data_found_layout" />

    <ProgressBar
        android:id="@+id/progressBar2"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/purple_700"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>