<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dimen_4">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/linearholderImage"
        android:layout_width="100dp"
        android:layout_height="70dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/grey"
        app:cardCornerRadius="@dimen/dimen_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <ImageView
                android:id="@+id/ivCategoryImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"

                android:scaleType="centerCrop"
                android:src="@drawable/no_pictures" />


        </LinearLayout>




    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/tvCatgoryName"
        android:layout_width="80dp"
        android:layout_height="wrap_content"


        android:gravity="center"
        android:singleLine="true"
        android:text="dummy text category name"
        android:textAlignment="center"
        android:textColor="@color/black_text"
        android:textSize="@dimen/text_size_14"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/linearholderImage"
        app:layout_constraintStart_toStartOf="@id/linearholderImage"
        app:layout_constraintTop_toBottomOf="@id/linearholderImage" />

</androidx.constraintlayout.widget.ConstraintLayout>