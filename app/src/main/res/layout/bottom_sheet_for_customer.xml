<!-- res/layout/bottom_sheet_layout.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/AppModalStyle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_dialog">

    <ProgressBar
        android:id="@+id/loadingView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
android:layout_gravity="center"
            android:id="@+id/ivImageDash"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dimen_16"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_drag"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/dimen_8"
            android:layout_marginTop="@dimen/dimen_16"
            android:layout_marginEnd="@dimen/dimen_8"
            android:background="@color/dividerColor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivImageDash"

            />


        <LinearLayout
            android:id="@+id/linearVerticalData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical"


            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <RadioGroup
                android:id="@+id/rgCustomerBottomSheet"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:weightSum="2"
android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/view1">

                <RadioButton
                    android:id="@+id/rbPrimaryCustomer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/leave_bg_selector"
                    android:button="@android:color/transparent"
                    android:checked="true"
                    android:gravity="center"
                    android:text="Primary"
                    android:textColor="@color/leavetext_seletor"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/leave_bg_selector"
                    android:button="@android:color/transparent"
                    android:checked="false"
                    android:gravity="center"
                    android:text="Secondary"
                    android:textColor="@color/leavetext_seletor"
                    android:textStyle="bold" />


            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/linearSearchActual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/size_8"
                    android:layout_weight="85"
                    android:background="@drawable/rounded_corner_stroke_colored"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/toolbarMore">


                    <EditText

                        android:id="@+id/edtSearchActual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/size_8"
                        android:layout_weight="90"
                        android:backgroundTint="@android:color/transparent"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Search By Area ,Outlet Name"

                        android:padding="4dp"
                        android:singleLine="true"
                        android:textSize="@dimen/text_size_12"

                        />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/colorPrimary"

                        />

                    <ImageButton
                        android:id="@+id/ibSearchActual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="20"
                        android:backgroundTint="@color/white"
                        android:src="@drawable/ic_search"
                        android:visibility="visible" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/ibImageSort"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="15"
                    android:backgroundTint="@color/dividerColor"
                    android:src="@drawable/ic_sort" />


            </LinearLayout>


        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCustomerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linearVerticalData" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
