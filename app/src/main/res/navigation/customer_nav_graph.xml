<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customer_nav_graph"
    app:startDestination="@id/customerBeatPlanFragment">

    <fragment
        android:id="@+id/notesFragment"
        android:name="com.preetTractor.galaxyAndroid.ui.fragment.NotesFragment"
        android:label="fragment_notes"
        tools:layout="@layout/fragment_notes" />
    <fragment
        android:id="@+id/orderFragment"
        android:name="com.preetTractor.galaxyAndroid.ui.fragment.OrderFragment"
        android:label="fragment_order"
        tools:layout="@layout/fragment_order" >
        <!--<action
            android:id="@+id/action_pendingOrderFragment_to_pendingOrderInnerFirstFragment"
            app:destination="@id/pendingOrderInnerFirstFragment" />-->
    </fragment>
    <fragment
        android:id="@+id/overViewFragment"
        android:name="com.preetTractor.galaxyAndroid.ui.fragment.OverViewFragment"
        android:label="fragment_over_view"
        tools:layout="@layout/fragment_over_view" />
    <fragment
        android:id="@+id/customerBeatPlanFragment"
        android:name="com.preetTractor.galaxyAndroid.ui.fragment.CustomerBeatPlanFragment"
        android:label="fragment_customer_beat_plan"
        tools:layout="@layout/customer_beat_plan" >
        <argument
            android:name="cardCode"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/secondaryFragment"
        android:name="com.preetTractor.galaxyAndroid.ui.fragment.SecondaryFragment"
        android:label="fragment_secondary"
        tools:layout="@layout/fragment_secondary" />
    <fragment
        android:id="@+id/pendingOrderInnerFirstFragment"
        android:name="com.preetTractor.galaxyAndroid.ui.orderUi.fragment.PendingOrderInnerFirstFragment"
        android:label="Pending Order Inner First Fragment"
        tools:layout="@layout/fragment_pending_order_inner_first">
        <argument
            android:name="data"
            app:argType="string" />
    </fragment>


</navigation>